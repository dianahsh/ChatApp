@model ChatApp.Models.Conversation

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Conversation</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <!--show messegas & form to message controller -->
    </dl>
    <div>
        @foreach(var item in Model.messages)
        {
            <div><p>@item.Text</p></div>
        }

    </div>
    <div>
        <form method="post" asp-controller="message" asp-action="Create">
            <input type="text" class="form-control" name="messageText" />
            <input type="hidden" name="convId" value="@Model.Id" />
            <input type="submit" value="Send" class="btn btn-primary" />
        </form>
    </div>
       
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
